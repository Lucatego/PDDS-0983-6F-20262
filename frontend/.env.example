# Origen de los datos de la simulación:
#   local  -> el motor corre en el navegador (sin backend). Valor por defecto.
#   server -> se conecta al backend Spring Boot (REST en /api, STOMP en /ws).
VITE_DATA_SOURCE=local

# Solo para VITE_DATA_SOURCE=server. Si se omiten, se usan rutas relativas
# (/api y ws(s)://<host>/ws), que el proxy de Vite o nginx redirigen al backend.
# VITE_API_URL=http://localhost:8080/api
# VITE_WS_URL=ws://localhost:8080/ws

# Backend al que apunta el proxy del servidor de desarrollo de Vite.
# BACKEND_URL=http://localhost:8080
