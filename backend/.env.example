# Credenciales de PostgreSQL del backend de PaqRap.
# Copiar a backend/.env (ignorado por git) y completar. Formato: CLAVE=valor, sin comillas.
# Por ahora la base está en AWS (RDS); el security group debe permitir la IP desde la que se conecta.

# jdbc:postgresql://<host>:<puerto>/<base>; RDS exige SSL (sslmode=require).
PAQRAP_DB_URL=jdbc:postgresql://<host>.rds.amazonaws.com:5432/paqrap?sslmode=require
PAQRAP_DB_USUARIO=paqrap
PAQRAP_DB_CLAVE=cambiar
