<?xml version="1.0" encoding="UTF-8"?>
<!--
    POM padre del backend de PaqRap (Centro de Operaciones), Equipo 6F, 1INF54-0983, PUCP 2026-2.
    Hereda de spring-boot-starter-parent para reutilizar la gestión de versiones y de plugins,
    pero el módulo planificador no depende de Spring.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>pe.pucp.paqrap</groupId>
    <artifactId>paqrap-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>PaqRap · Backend</name>
    <description>Backend de PaqRap: planificador Tabu Search y aplicación Spring Boot.</description>

    <modules>
        <module>planificador</module>
        <module>aplicacion</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>pe.pucp.paqrap</groupId>
                <artifactId>planificador</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
